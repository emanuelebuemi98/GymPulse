// Schema del database GymPulse.
// PostgreSQL: in locale tramite Docker, online su Supabase.
//
// Ogni persona ha il proprio account e i propri dati: giornate, esercizi, sedute e serie portano
// sempre lo userId. Le chiavi esterne composte (userId, ...) impediscono a un dato di puntare a quello
// di un'altra persona, anche conoscendone l'id.
//
// Id: in ogni tabella è il primo campo. User, Esercizio e Sessione hanno un numero progressivo. La giornata
// ha la sigla (A, B, C) e vale per persona, quindi la chiave è (userId, id). Voci della scheda e serie hanno
// un id testuale casuale.
//
// L'ordine dei campi qui è anche l'ordine delle colonne nel database: se lo cambi, la migrazione deve
// ricostruire la tabella (Postgres non sposta le colonne).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Account. Si crea dalla registrazione nell'app. fullName è il nome completo; username e passwordHash servono
// al login (passwordHash è un hash scrypt, mai la password). email è l'indirizzo confermato con un codice: è dove
// arrivano i codici per reimpostare la password. Vuota finché la persona non la aggiunge (gli account nuovi la hanno
// sempre, perché la registrazione la richiede).
model User {
  id           Int            @id @default(autoincrement())
  fullName     String
  username     String         @unique
  passwordHash String
  email        String?
  giorni       GiornoScheda[]
  esercizi     Esercizio[]
  sessioni     Sessione[]
  codiciEmail  CodiceEmail[]
}

// Codice monouso mandato per email: serve a confermare un indirizzo (scopo "email") e a reimpostare la password
// (scopo "recupero"). Di ogni codice si salva solo un HMAC, mai il numero a sei cifre. email è l'indirizzo a cui è
// stato mandato; chiave è lo stesso indirizzo in forma canonica (senza "+qualcosa" e, per Gmail, senza punti) e serve
// ai limiti: name+1@gmail.com e name+2@gmail.com arrivano nella stessa casella e contano come uno. Le righe vecchie
// si cancellano da sole.
model CodiceEmail {
  id         Int      @id @default(autoincrement())
  userId     Int
  scopo      String
  email      String
  chiave     String
  codiceHash String
  tentativi  Int      @default(0)
  creatoIl   DateTime @default(now())
  scadeIl    DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, creatoIl])
  @@index([chiave, creatoIl])
  @@index([creatoIl])
}

// Registrazione in attesa del codice per email. L'account non esiste ancora: si crea solo quando l'indirizzo è
// confermato, così nessuno si registra con un indirizzo sbagliato (e quindi senza poter recuperare la password) o
// altrui. L'id è casuale (uuid) perché è l'unica cosa che lega il browser alla registrazione. La password è già un
// hash scrypt. Una registrazione usata o scaduta resta qui due giorni, perché conta nei limiti degli invii.
model RegistrazioneSospesa {
  id           String   @id @default(uuid())
  fullName     String
  username     String
  passwordHash String
  email        String
  chiave       String
  codiceHash   String
  tentativi    Int      @default(0)
  creatoIl     DateTime @default(now())
  scadeIl      DateTime

  @@index([chiave, creatoIl])
  @@index([creatoIl])
}

// Giornata della scheda di una persona. L'id è la sigla (A, B, C, ...): una lettera, e le giornate attive sono da 1 a
// 7. L'ordine è quello delle sigle. Una nuova giornata prende la lettera dopo l'ultima usata, quindi le sigle possono
// avere dei buchi (A, C, D) se se ne è tolta una in mezzo.
// attiva = false: la giornata è stata tolta dalla scheda ma ha delle sedute registrate, che non si possono perdere.
// Resta nel database solo per lo storico (nome e sigla), non compare più nella scheda e non si propone più.
// Una giornata senza sedute, quando la si toglie, si cancella davvero.
model GiornoScheda {
  id       String
  userId   Int
  titolo   String
  attiva   Boolean      @default(true)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  voci     VoceScheda[]
  sessioni Sessione[]

  @@id([userId, id])
}

// Esercizi noti a una persona: quelli della sua scheda e quelli che ha aggiunto.
// L'unicità (userId, id) serve alle chiavi esterne composte di voci e serie.
// muscoli: il gruppo muscolare dell'esercizio, uno solo tra PETTO, SPALLE, BICIPITI, TRICIPITI, DORSO, GAMBE, ADDOME.
// Il database accetta solo questi nomi (vincolo Esercizio_muscoli_standard, scritto a mano nella migrazione perché
// Prisma non lo descrive) o il testo vuoto, che resta agli esercizi arrivati da un CSV finché non li si apre dalla scheda.
model Esercizio {
  id      Int             @id @default(autoincrement())
  userId  Int
  nome    String
  muscoli String
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  voci    VoceScheda[]
  serie   SerieEseguita[]

  @@unique([userId, id])
}

// Un esercizio dentro una giornata, con il suo obiettivo. È la parte modificabile dall'app.
// tipo = "serie":  serie × ripMin-ripMax, con recuperoSec
// tipo = "totale": ripTotali da accumulare su più serie
// tipo = "libero": da serieMin a serieMax serie a scelta
model VoceScheda {
  id           String       @id @default(cuid())
  userId       Int
  giornoId     String
  esercizioId  Int
  ordine       Int
  tipo         String       @default("serie")
  serie        Int?
  ripMin       Int?
  ripMax       Int?
  recuperoSec  Int?
  ripTotali    Int?
  serieMin     Int?
  serieMax     Int?
  nota         String?
  incrementoKg Float?
  giorno       GiornoScheda @relation(fields: [userId, giornoId], references: [userId, id], onDelete: Cascade)
  esercizio    Esercizio    @relation(fields: [userId, esercizioId], references: [userId, id], onDelete: NoAction)

  @@unique([userId, giornoId, esercizioId])
  @@index([userId, giornoId, ordine])
}

// Un allenamento svolto in palestra in una certa data.
// datiIniziali = true: serie importate a mano, con ripetizioni pari all'obiettivo e non registrate.
model Sessione {
  id           Int             @id @default(autoincrement())
  userId       Int
  giornoId     String
  data         DateTime        @default(now())
  note         String?
  durataMinuti Int?
  datiIniziali Boolean         @default(false)
  // Dati dell'orologio, scritti a mano o letti da un file TCX. Vuoti se per la seduta non ci sono.
  fcMediaBpm   Int?
  fcMassimaBpm Int?
  kcalOrologio Int?
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  giorno       GiornoScheda    @relation(fields: [userId, giornoId], references: [userId, id], onDelete: NoAction)
  serie        SerieEseguita[]

  @@unique([id, userId])
  @@index([userId, data])
}

// Una serie registrata. Il peso è vuoto per gli esercizi a corpo libero.
// ordine = posizione della serie nella sessione (1, 2, 3, ...), anche tra esercizi diversi.
// userId deve essere lo stesso della sessione e dell'esercizio: lo garantiscono le due chiavi esterne.
model SerieEseguita {
  id          String    @id @default(cuid())
  userId      Int
  sessioneId  Int
  esercizioId Int
  ordine      Int
  pesoKg      Float?
  ripetizioni Int
  sessione    Sessione  @relation(fields: [sessioneId, userId], references: [id, userId], onDelete: Cascade)
  esercizio   Esercizio @relation(fields: [userId, esercizioId], references: [userId, id], onDelete: NoAction)

  @@index([sessioneId])
  @@index([userId, esercizioId])
}
