// Schema del database GymPulse.
// PostgreSQL: in locale tramite Docker, online su Supabase.
//
// Ogni persona ha il proprio account e i propri dati: giornate, esercizi, sedute e serie portano
// sempre lo userId. Le chiavi esterne composte (userId, ...) impediscono a un dato di puntare a quello
// di un'altra persona, anche conoscendone l'id.
//
// Id: in ogni tabella è il primo campo. User, Esercizio e Sessione hanno un numero progressivo. La giornata
// ha la sigla (A, B, C) e vale per persona, quindi la chiave è (userId, id). Voci della scheda e serie hanno
// un id testuale casuale.
//
// L'ordine dei campi qui è anche l'ordine delle colonne nel database: se lo cambi, la migrazione deve
// ricostruire la tabella (Postgres non sposta le colonne).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Account. Si crea dalla registrazione nell'app. fullName è il nome completo; username e passwordHash servono
// al login (passwordHash è un hash scrypt, mai la password). email è un indirizzo Gmail: è dove arrivano i codici per
// reimpostare la password. Alla registrazione si scrive e basta (non si conferma con un codice); cambiandola dalla pagina
// Account, invece, la nuova si conferma con un codice. Vuota solo negli account molto vecchi.
// palestra: facoltativa, una di quelle di src/lib/palestre.ts scritta in maiuscolo. Sceglierla è anche il consenso: i personal
// trainer della stessa palestra possono vedere e modificare la scheda (mai sedute, kg, grafici o email) di chi l'ha scelta.
// ruolo: 'utente' o 'trainer' (vincolo User_ruolo, scritto a mano nella migrazione). Un trainer ha sempre la palestra (vincolo
// User_trainer_palestra) e si registra solo con il codice d'invito.
model User {
  id           Int            @id @default(autoincrement())
  fullName     String
  username     String         @unique
  passwordHash String
  email        String?
  giorni       GiornoScheda[] @relation("SchedaDi")
  esercizi     Esercizio[]
  sessioni     Sessione[]
  codiciEmail  CodiceEmail[]
  modificate   GiornoScheda[] @relation("ModificataDa")
  palestra     String?
  ruolo        String         @default("utente")

  @@index([palestra, ruolo])
}

// Codice monouso mandato per email: serve a confermare un indirizzo (scopo "email") e a reimpostare la password
// (scopo "recupero"). Di ogni codice si salva solo un HMAC, mai il numero a sei cifre. email è l'indirizzo a cui è
// stato mandato; chiave è lo stesso indirizzo in forma canonica (senza "+qualcosa" e, per Gmail, senza punti) e serve
// ai limiti: name+1@gmail.com e name+2@gmail.com arrivano nella stessa casella e contano come uno. Le righe vecchie
// si cancellano da sole.
model CodiceEmail {
  id         Int      @id @default(autoincrement())
  userId     Int
  scopo      String
  email      String
  chiave     String
  codiceHash String
  tentativi  Int      @default(0)
  creatoIl   DateTime @default(now())
  scadeIl    DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, creatoIl])
  @@index([chiave, creatoIl])
  @@index([creatoIl])
}

// Giornata della scheda di una persona. L'id è la sigla (A, B, C, ...): una lettera, e le giornate attive sono da 1 a
// 7. L'ordine è quello delle sigle. Una nuova giornata prende la lettera dopo l'ultima usata, quindi le sigle possono
// avere dei buchi (A, C, D) se se ne è tolta una in mezzo.
// attiva = false: la giornata è stata tolta dalla scheda ma ha delle sedute registrate, che non si possono perdere.
// Resta nel database solo per lo storico (nome e sigla), non compare più nella scheda e non si propone più.
// Una giornata senza sedute, quando la si toglie, si cancella davvero.
// modificatoDaId / modificatoIl: chi ha modificato la giornata per ultimo (l'utente stesso o un personal trainer della sua
// palestra) e quando. Servono a far leggere all'utente «Modificata da NOME» e a non sovrascrivere un salvataggio più recente.
model GiornoScheda {
  id             String
  userId         Int
  titolo         String
  attiva         Boolean      @default(true)
  user           User         @relation("SchedaDi", fields: [userId], references: [id], onDelete: Cascade)
  voci           VoceScheda[]
  sessioni       Sessione[]
  modificatoDaId Int?
  modificatoIl   DateTime?
  modificatoDa   User?        @relation("ModificataDa", fields: [modificatoDaId], references: [id], onDelete: SetNull)

  @@id([userId, id])
}

// Catalogo degli esercizi, uguale per tutti e non modificabile dall'app: si carica con `npm run db:catalogo` dal file
// prisma/dati/catalogo-esercizi.json. Gli esercizi di una persona (Esercizio) si collegano qui con catalogoId.
// slug è il nome inglese in minuscolo e con i trattini: è la chiave con cui lo script ritrova una riga già caricata, e
// anche il nome del file della foto. categoria è una di nove chiavi (vincolo CatalogoEsercizio_categoria, scritto a mano
// nelle migrazioni perché Prisma non lo descrive). immagine è il percorso della foto, vuoto finché non c'è.
// esecuzione: come si fa l'esercizio, un passo per riga. accortezze: gli errori da evitare e le cautele, una per riga.
// Si mostrano nella scheda dell'esercizio, dopo averlo scelto. Vuoti finché non sono scritti.
model CatalogoEsercizio {
  id                Int         @id @default(autoincrement())
  slug              String      @unique
  nomeIt            String      @unique
  nomeEn            String
  categoria         String
  attrezzatura      String
  muscoloPrincipale String
  muscoliSecondari  String
  tipoMovimento     String
  immagine          String?
  esecuzione        String?
  accortezze        String?
  esercizi          Esercizio[]

  @@index([categoria])
}

// Esercizi noti a una persona: quelli presi dal catalogo e quelli che ha scritto lei.
// L'unicità (userId, id) serve alle chiavi esterne composte di voci e serie.
// categoria: una delle nove categorie (stesso vincolo del catalogo, Esercizio_categoria), oppure il testo vuoto per gli
// esercizi arrivati da un CSV, finché non si sceglie la categoria dalla scheda. Quando c'è catalogoId la categoria è
// quella del catalogo. Un esercizio con catalogoId vuoto è personale.
model Esercizio {
  id          Int                @id @default(autoincrement())
  userId      Int
  nome        String
  categoria   String
  catalogoId  Int?
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogo    CatalogoEsercizio? @relation(fields: [catalogoId], references: [id], onDelete: SetNull)
  voci        VoceScheda[]
  serie       SerieEseguita[]

  @@unique([userId, id])
  @@unique([userId, catalogoId])
  @@index([catalogoId])
}

// Un esercizio dentro una giornata, con il suo obiettivo. È la parte modificabile dall'app.
// tipo = "serie":  serie × ripMin-ripMax, con recuperoSec
// tipo = "totale": ripTotali da accumulare su più serie
// tipo = "libero": da serieMin a serieMax serie a scelta
model VoceScheda {
  id           String       @id @default(cuid())
  userId       Int
  giornoId     String
  esercizioId  Int
  ordine       Int
  tipo         String       @default("serie")
  serie        Int?
  ripMin       Int?
  ripMax       Int?
  recuperoSec  Int?
  ripTotali    Int?
  serieMin     Int?
  serieMax     Int?
  nota         String?
  incrementoKg Float?
  giorno       GiornoScheda @relation(fields: [userId, giornoId], references: [userId, id], onDelete: Cascade)
  esercizio    Esercizio    @relation(fields: [userId, esercizioId], references: [userId, id], onDelete: NoAction)

  @@unique([userId, giornoId, esercizioId])
  @@index([userId, giornoId, ordine])
}

// Un allenamento svolto in palestra in una certa data.
// datiIniziali = true: serie importate a mano, con ripetizioni pari all'obiettivo e non registrate.
model Sessione {
  id           Int             @id @default(autoincrement())
  userId       Int
  giornoId     String
  data         DateTime        @default(now())
  note         String?
  durataMinuti Int?
  datiIniziali Boolean         @default(false)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  giorno       GiornoScheda    @relation(fields: [userId, giornoId], references: [userId, id], onDelete: NoAction)
  serie        SerieEseguita[]

  @@unique([id, userId])
  @@index([userId, data])
}

// Una serie registrata. Il peso è vuoto per gli esercizi a corpo libero.
// ordine = posizione della serie nella sessione (1, 2, 3, ...), anche tra esercizi diversi.
// userId deve essere lo stesso della sessione e dell'esercizio: lo garantiscono le due chiavi esterne.
model SerieEseguita {
  id          String    @id @default(cuid())
  userId      Int
  sessioneId  Int
  esercizioId Int
  ordine      Int
  pesoKg      Float?
  ripetizioni Int
  sessione    Sessione  @relation(fields: [sessioneId, userId], references: [id, userId], onDelete: Cascade)
  esercizio   Esercizio @relation(fields: [userId, esercizioId], references: [userId, id], onDelete: NoAction)

  @@index([sessioneId])
  @@index([userId, esercizioId])
}
